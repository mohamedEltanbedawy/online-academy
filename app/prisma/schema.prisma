// ملف قاعدة البيانات — الأصناف (Models) بتاعه كل حاجة في المنصة
// أي تعديل هنا → تعمل الأمر: npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// الأدوار في المنصة
enum Role {
  STUDENT // طالب
  TEACHER // مدرس
  ADMIN // مشرف عام
  CASHIER // موظف منفذ بيع
  PARENT // ولي أمر
  STAFF // أخصائي أو موظف حضانة
}

// الطالب جاي من فين؟ (بيحدد نموذج الربح)
enum RevenueSource {
  PLATFORM // جاي من دعاية المنصة → المنصة بتاخد نسبة
  TEACHER // جاي مع المدرس نفسه → المنصة بتاخد كلفة ثابتة
}

// حالة الاشتراك في فصل
enum EnrollmentStatus {
  ACTIVE // مشترك وبيحضر
  BLOCKED // المدرس منعه
  LEFT // الطالب ساب الفصل
}

// حالة الفصل
enum ClassStatus {
  ACTIVE // شغال
  ARCHIVED // مقفول
}

// حالة حل الطالب للواجب
enum SubmissionStatus {
  SUBMITTED // تم التسليم وينتظر التصحيح
  GRADED // تم التصحيح
}

enum RecordingStatus {
  STARTING
  RECORDING
  STOPPED
  FAILED
}

enum PaymentMethod {
  CASH
  MOBILE_WALLET
  BANK_TRANSFER
  GATEWAY
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PAID
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum AttendanceMode {
  ONSITE
  ONLINE
}

enum ActivityEnrollmentStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
}

enum NurserySubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  PAST_DUE
}

enum NurseryInvoiceStatus {
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

// نوع المستأجر (العائلة = نواة النظام، المؤسسة/المزود = عائلة تعليمية أو روضة)
enum TenantType {
  FAMILY // عائلة
  INSTITUTION // مؤسسة تعليمية (روضة/أكاديمية)
  PROVIDER // مزود خدمات (مدرسين/أخصائيين)
}

// نوع العلاقة بين شخصين
enum RelationshipType {
  PARENT_OF // أب/أم لـ
  SPOUSE // زوج/زوجة
  SIBLING // أخ/أخت
  GRANDPARENT_OF // جد/جدة لـ
  GUARDIAN_OF // ولي أمر لـ
  OTHER // علاقة أخرى
}

// نوع حدث في تقويم العائلة
enum FamilyEventType {
  LESSON // حصة
  ACTIVITY // نشاط
  APPOINTMENT // موعد (طبيب/مقابلة)
  BIRTHDAY // عيد ميلاد
  CUSTOM // مناسبة خاصة
}

// نوع عنصر في الخطة اليومية
enum PlanItemType {
  TASK // مهمة
  LESSON // حصة
  ACTIVITY // نشاط
  REMINDER // تذكير
}

// المستخدم (مدرس / طالب / أدمن / موظف)
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacherProfile TeacherProfile?
  classes        Class[]
  enrollments    Enrollment[]
  submissions    Submission[]
  studentPayments Payment[] @relation("StudentPayments")
  cashierPayments Payment[] @relation("CashierPayments")
  auditLogs      AuditLog[] @relation("AuditActors")
  teacherPayouts Payout[]   @relation("TeacherPayouts")
  guardianLinks  ChildGuardian[] @relation("GuardianChildren")
  assessmentsGiven ChildAssessment[] @relation("AssessmentAssessor")
  staffProfile StaffProfile?
  recordedAttendance ChildAttendance[] @relation("AttendanceRecorder")
  createdActivities Activity[] @relation("ActivityCreator")
  person Person?
  userRoles UserRole[]
  uploadedHealthDocuments HealthDocument[] @relation("HealthDocUploader")
  telegramChats TelegramChat[]
  telegramLinkCodes TelegramLinkCode[]
}

// بيانات المدرس التكميلية (المادة والوصف والأسعار الافتراضية)
model TeacherProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject                String // المادة الأساسية
  bio                    String? // وصف المدرس
  defaultHourlyRate      Decimal  @default(0) @db.Decimal(10, 2) // سعر الحصة الافتراضي
  defaultPlatformPercent Decimal  @default(0) @db.Decimal(5, 2) // نسبة المنصة الافتراضية لطلبة الدعاية
  defaultFixedFee        Decimal  @default(0) @db.Decimal(10, 2) // الكلفة الثابتة الافتراضية لطلبة المدرس
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// الفصل / الكورس — بيحدد المدرس طريقة الربح فيه
model Class {
  id              String      @id @default(cuid())
  teacherId       String
  teacher         User        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name            String // اسم الفصل
  subject         String // المادة
  description     String? // وصف الفصل
  pricePerHour    Decimal     @db.Decimal(10, 2) // سعر الحصة للطالب
  platformPercent Decimal     @default(0) @db.Decimal(5, 2) // نسبة المنصة من حصة طالب الدعاية (٪)
  fixedFee        Decimal     @default(0) @db.Decimal(10, 2) // كلفة المنصة الثابتة لكل حصة لطالب المدرس
  inviteCode      String      @unique // كود دعوة الطلبة
  status          ClassStatus @default(ACTIVE)
  tenantId        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  enrollments Enrollment[]
  schedules   SessionSchedule[]
  homeworks   Homework[]
  recordings  Recording[]
  payments    Payment[]

  @@index([tenantId])
}

// اشتراك طالب في فصل
model Enrollment {
  id        String           @id @default(cuid())
  classId   String
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId String
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  source    RevenueSource    @default(TEACHER) // الطالب جاي من فين؟
  status    EnrollmentStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())

  @@unique([classId, studentId])
}

// جدول الحصص الأسبوعي المتكرر للفصل
model SessionSchedule {
  id              String   @id @default(cuid())
  classId         String
  class           Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  title           String? // تسمية اختيارية (مثال: حصة الجبر)
  dayOfWeek       Int // 0=الأحد، 1=الاثنين ... 6=السبت (بنفس ترتيب getDay في JS)
  startTime       String // "HH:mm"
  durationMinutes Int      @default(60)
  createdAt       DateTime @default(now())
}

// واجب مرتبط بفصل
model Homework {
  id           String   @id @default(cuid())
  classId      String
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  title        String
  instructions String
  dueAt        DateTime?
  maxScore     Int      @default(100)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions Submission[]
}

// حل طالب لواجب، بحد أقصى حل واحد لكل طالب
model Submission {
  id         String           @id @default(cuid())
  homeworkId String
  homework   Homework         @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId  String
  student    User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answer     String
  status     SubmissionStatus @default(SUBMITTED)
  score      Int?
  feedback   String?
  submittedAt DateTime         @default(now())
  gradedAt   DateTime?
  updatedAt  DateTime         @updatedAt

  @@unique([homeworkId, studentId])
}

// تسجيل فيديو لحصة مباشرة
model Recording {
  id            String          @id @default(cuid())
  classId       String
  class         Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  egressId      String          @unique
  title         String
  status        RecordingStatus @default(STARTING)
  active        Boolean         @default(true)
  filePath      String?
  startedAt     DateTime         @default(now())
  endedAt       DateTime?
  durationSeconds Int?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

// دفعة مالية — المبلغ محفوظ بدقة خانتين عشريتين
model Payment {
  id            String        @id @default(cuid())
  receiptNumber String        @unique
  studentId     String?
  student       User?         @relation("StudentPayments", fields: [studentId], references: [id], onDelete: SetNull)
  cashierId     String
  cashier       User          @relation("CashierPayments", fields: [cashierId], references: [id], onDelete: Restrict)
  classId       String?
  class         Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PAID)
  description   String
  gatewayOrderId       String? @unique
  gatewayTransactionId String?
  gatewayResponse      Json?
  paidAt        DateTime      @default(now())
  tenantId      String?
  createdAt     DateTime      @default(now())
  payout        Payout?
  nurseryInvoiceId String? @unique
  nurseryInvoice NurseryInvoice? @relation(fields: [nurseryInvoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

// سجل تغييرات الإدارة
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation("AuditActors", fields: [actorId], references: [id], onDelete: Restrict)
  action    String
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

// تسوية نصيب المدرس من دفعة
model Payout {
  id            String       @id @default(cuid())
  paymentId     String       @unique
  payment       Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  teacherId     String
  teacher       User         @relation("TeacherPayouts", fields: [teacherId], references: [id], onDelete: Restrict)
  grossAmount   Decimal      @db.Decimal(12, 2)
  platformFee   Decimal      @db.Decimal(12, 2)
  teacherAmount Decimal      @db.Decimal(12, 2)
  status        PayoutStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  paidAt        DateTime?
}

// ملف طفل في الحضانة والأكاديمية
model Child {
  id          String   @id @default(cuid())
  name        String
  birthDate   DateTime
  stage       String?
  schoolGrade String?
  notes       String?
  medicalNotes String?
  active      Boolean  @default(true)
  tenantId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guardians ChildGuardian[]
  programs  ChildProgram[]
  assessments ChildAssessment[]
  attendance ChildAttendance[]
  activities ActivityEnrollment[]
  subscriptions NurserySubscription[]
  invoices NurseryInvoice[]
  growthRecords GrowthRecord[]
  vaccinations Vaccination[]
  sleepRecords SleepRecord[]
  nutritionRecords NutritionRecord[]
  medicines Medicine[]
  healthDocuments HealthDocument[]

  @@index([tenantId])
}

// ربط طفل بولي أمر مع إمكانية وجود أكثر من ولي
model ChildGuardian {
  childId    String
  child      Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  guardianId String
  guardian   User   @relation("GuardianChildren", fields: [guardianId], references: [id], onDelete: Cascade)
  relation   String  @default("ولي أمر")
  primary    Boolean @default(false)

  @@id([childId, guardianId])
  @@index([guardianId])
}

// مرحلة تعليمية قابلة للتعديل من لوحة الإدارة
model AcademyStage {
  id          String    @id @default(cuid())
  name        String
  ageMin      Int
  ageMax      Int
  description String?
  active      Boolean   @default(true)
  tenantId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  programs AcademyProgram[]

  @@index([tenantId])
}

// قالب البرنامج: المنهج الرسمي والإنجليزي والرياضيات والأنشطة
model AcademyProgram {
  id           String        @id @default(cuid())
  stageId      String
  stage        AcademyStage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  subjectsJson Json?
  objectives   String?
  version      Int           @default(1)
  active       Boolean       @default(true)
  tenantId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  childPrograms ChildProgram[]

  @@index([tenantId])
}

// نسخة مخصصة من برنامج لطفل بعينه
model ChildProgram {
  id          String         @id @default(cuid())
  childId     String
  child       Child          @relation(fields: [childId], references: [id], onDelete: Cascade)
  programId   String
  program     AcademyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  customPlan  String?
  focusAreas  Json?
  startedAt   DateTime       @default(now())
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([childId, active])
}

// مهارة قابلة للتقييم
model Skill {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?
  active      Boolean  @default(true)
  tenantId    String?
  createdAt   DateTime @default(now())

  assessments ChildAssessment[]

  @@index([tenantId])
}

// تقييم مهارة طفل بواسطة مدرس أو أخصائي
model ChildAssessment {
  id          String   @id @default(cuid())
  childId     String
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  assessorId  String
  assessor    User     @relation("AssessmentAssessor", fields: [assessorId], references: [id], onDelete: Restrict)
  score       Int
  notes       String?
  assessedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([childId, skillId, assessedAt])
}

model StaffProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization String
  bio          String?
  active       Boolean  @default(true)
}

model ChildAttendance {
  id          String           @id @default(cuid())
  childId     String
  child       Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedById String
  recordedBy  User             @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  date        DateTime         @default(now())
  status      AttendanceStatus
  mode        AttendanceMode
  note        String?
  createdAt   DateTime         @default(now())

  @@unique([childId, date, mode])
  @@index([childId, date])
}

model Activity {
  id          String   @id @default(cuid())
  title       String
  type        String
  description String?
  scheduledAt DateTime
  location    String?
  capacity    Int      @default(20)
  active      Boolean  @default(true)
  tenantId    String?
  createdById String
  createdBy   User     @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  enrollments ActivityEnrollment[]

  @@index([tenantId])
}

model ActivityEnrollment {
  id         String                   @id @default(cuid())
  activityId String
  activity   Activity                 @relation(fields: [activityId], references: [id], onDelete: Cascade)
  childId    String
  child      Child                    @relation(fields: [childId], references: [id], onDelete: Cascade)
  status     ActivityEnrollmentStatus @default(REGISTERED)
  createdAt  DateTime                 @default(now())

  @@unique([activityId, childId])
}

model NurserySubscription {
  id            String                    @id @default(cuid())
  childId       String
  child         Child                     @relation(fields: [childId], references: [id], onDelete: Cascade)
  planName      String
  monthlyAmount Decimal                   @db.Decimal(12, 2)
  discount      Decimal                   @default(0) @db.Decimal(12, 2)
  startDate     DateTime
  nextDueDate   DateTime
  status        NurserySubscriptionStatus @default(ACTIVE)
  notes         String?
  tenantId      String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  invoices NurseryInvoice[]

  @@index([tenantId])
}

model NurseryInvoice {
  id             String                @id @default(cuid())
  invoiceNumber  String                @unique
  childId        String
  child          Child                 @relation(fields: [childId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   NurserySubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount         Decimal               @db.Decimal(12, 2)
  dueDate        DateTime
  status         NurseryInvoiceStatus  @default(ISSUED)
  paidAt         DateTime?
  createdAt      DateTime              @default(now())
  payment        Payment?
}

// ===== Family OS: العائلة هي النواة =====
// المستأجر: كل عائلة مستأجر مستقل، والمؤسسات مستأجر من نوع مزود

model Tenant {
  id        String     @id @default(cuid())
  name      String // اسم المستأجر (مثال: "عائلة محمد" أو "أكاديمية القرية")
  slug      String     @unique // معرّف قصير للنظام
  type      TenantType @default(FAMILY)
  locale    String     @default("ar") // اللغة الافتراضية (ar/en)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  persons        Person[]
  families       Family[]
  relationships  Relationship[]
  aiProviders    AiProvider[]
}

// الشخص = التوأم الرقمي لأي إنسان (له حساب دخول اختياري)
model Person {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fullName  String
  birthDate DateTime?
  gender    String?
  avatarUrl String?
  userId    String?   @unique // الحساب مرتبط اختياريًا بالشخص
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  externalKey String? @unique // مفتاح ربط السجلات القديمة (child:<id>, legacy)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  families       FamilyMember[]
  familiesHeaded Family[]      @relation("FamilyHead")
  relationshipsA Relationship[] @relation("PersonRelationshipsA")
  relationshipsB Relationship[] @relation("PersonRelationshipsB")
  createdEvents  FamilyEvent[] @relation("EventCreator")
  assignedPlanItems PlanItem[] @relation("PlanAssignee")

  @@index([tenantId])
}

// العائلة داخل المستأجر
model Family {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  headPersonId  String?
  headPerson    Person?  @relation("FamilyHead", fields: [headPersonId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members   FamilyMember[]
  events    FamilyEvent[]
  planItems PlanItem[]

  @@index([tenantId])
}

// عضو في عائلة مع الدور داخل الأسرة
model FamilyMember {
  id        String  @id @default(cuid())
  familyId  String
  family    Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  personId  String
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  role      String  @default("فرد") // أب / أم / طفل / جد / جدة ...
  isPrimary Boolean @default(false) // ولي الأمر الأساسي للطفل

  @@unique([familyId, personId])
  @@index([personId])
}

// علاقة ثنائية موجهة بين شخصين (من → إلى)
model Relationship {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromPersonId String
  fromPerson   Person           @relation("PersonRelationshipsA", fields: [fromPersonId], references: [id], onDelete: Cascade)
  toPersonId   String
  toPerson     Person           @relation("PersonRelationshipsB", fields: [toPersonId], references: [id], onDelete: Cascade)
  type         RelationshipType
  notes        String?
  createdAt    DateTime         @default(now())

  @@index([fromPersonId])
  @@index([toPersonId])
}

// ===== Family OS: التقويم العائلي =====
// حدث في تقويم العائلة (حصة/نشاط/موعد/عيد ميلاد/مناسبة)

model FamilyEvent {
  id         String          @id @default(cuid())
  tenantId   String
  familyId   String?
  family     Family?         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  title      String
  type       FamilyEventType @default(CUSTOM)
  startsAt   DateTime
  endsAt     DateTime?
  location   String?
  notes      String?
  completed  Boolean         @default(false)
  createdById String?
  createdBy  Person?         @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([tenantId, startsAt])
  @@index([familyId])
}

// عنصر في الخطة اليومية للعائلة (مهمة/حصة/نشاط/تذكير)

model PlanItem {
  id           String       @id @default(cuid())
  tenantId     String
  familyId     String?
  family       Family?      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  day          DateTime // يوم الخطة (التاريخ فقط)
  title        String
  time         String? // "HH:mm"
  type         PlanItemType @default(TASK)
  assignedToId String?
  assignedTo   Person?      @relation("PlanAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  done         Boolean      @default(false)
  doneAt       DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([tenantId, day])
  @@index([familyId])
  @@index([assignedToId])
}

// ===== M3: الصحة (Health) =====

// قياس نمو الطفل (وزن/طول/محيط رأس)
model GrowthRecord {
  id       String   @id @default(cuid())
  tenantId String?
  childId  String
  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  date     DateTime // يوم القياس
  weightKg Decimal? @db.Decimal(6, 2)
  heightCm Decimal? @db.Decimal(6, 2)
  headCm   Decimal? @db.Decimal(6, 2)
  notes    String?
  createdAt DateTime @default(now())

  @@index([childId, date])
  @@index([tenantId])
}

// تطعيم الطفل
model Vaccination {
  id          String   @id @default(cuid())
  tenantId    String?
  childId     String
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  name        String // اسم التطعيم
  dose        String? // الجرعة
  date        DateTime // تاريخ التطعيم
  nextDueDate DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([childId, date])
  @@index([tenantId])
}

// نوم الطفل (ساعات وجودة)
model SleepRecord {
  id       String   @id @default(cuid())
  tenantId String?
  childId  String
  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  date     DateTime
  hours    Decimal? @db.Decimal(4, 2) // عدد الساعات
  quality  String? // جودة النوم (جيدة/متوسطة/سيئة)
  notes    String?
  createdAt DateTime @default(now())

  @@index([childId, date])
  @@index([tenantId])
}

// غذاء الطفل (وجبة وأطعمة)
model NutritionRecord {
  id        String   @id @default(cuid())
  tenantId  String?
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  date      DateTime
  meal      String? // الوجبة (فطار/غدا/عشا/سناك)
  foods     String // الأطعمة المتناولة
  notes     String?
  createdAt DateTime @default(now())

  @@index([childId, date])
  @@index([tenantId])
}

// دواء الطفل
model Medicine {
  id        String   @id @default(cuid())
  tenantId  String?
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  name      String // اسم الدواء
  dosage    String? // الجرعة
  frequency String? // التكرار (مثال: كل 8 ساعات)
  startDate DateTime?
  endDate   DateTime?
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([childId])
  @@index([tenantId])
}

// ملف صحي مرفوع (تقرير/شهادة تطعيم/وصفة)
model HealthDocument {
  id           String   @id @default(cuid())
  tenantId     String?
  childId      String
  child        Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  title        String?
  category     String? // نوع الملف (تقرير/شهادة تطعيم/وصفة/أخرى)
  fileName     String // اسم الملف الأصلي
  mimeType     String
  sizeBytes    Int
  storagePath  String // المسار على القرص
  uploadedById String?
  uploadedBy   User?    @relation("HealthDocUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([childId])
  @@index([tenantId])
}

// ===== M3: إدارة مقدمي الـ AI =====

enum AiProviderType {
  GEMINI
  OPENAI
  OLLAMA
}

model AiProvider {
  id         String         @id @default(cuid())
  name       String // اسم يظهر في اللوحة (مثال: "Gemini Flash")
  provider   AiProviderType // نوع المزود
  modelName  String // اسم الموديل (مثال: gemini-2.5-flash / gpt-4o-mini / llama3.1)
  baseUrl    String? // للموديلات المحلية (Ollama) أو وكلاء مخصصة
  apiKey     String? // مفتاح API (نصي — لا يُرفع على GitHub)
  isDefault  Boolean  @default(false) // الموديل الافتراضي لكل النظام
  enabled    Boolean  @default(true)
  supportsVision Boolean @default(false) // هل الموديل بيفهم صور وورق؟
  temperature Float?
  maxTokens  Int?
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
}

// ===== M3: الصلاحيات (RBAC) =====

// صلاحية واحدة (مثال: "إدارة المستخدمين" = admin:users:manage)
model Permission {
  id     String @id @default(cuid())
  code   String @unique // مثال: admin:users:manage
  label  String // وصف عربي يظهر للمدير
  module String // الوحدة: admin / users / health / ai / family ...
  roles  RolePermission[]

  @@index([module])
}

// دور = مجموعة صلاحيات (مثال: "مشرف عام" له كل الصلاحيات)
model AccessRole {
  id          String @id @default(cuid())
  name        String @unique // ADMIN / TEACHER / PARENT ...
  label       String // اسم عربي للدور
  isSystem    Boolean @default(false) // أدوار النظام الأساسية (غير قابلة للحذف)
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  role         AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ربط المستخدم بأدواره (أكثر من دور ممكن)
model UserRole {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

// ===== M3: بوت تيليجرام =====

// ربط محادثة تيليجرام بحساب على المنصة (بعد "الربط" برمز من اللوحة)
model TelegramChat {
  id       String   @id @default(cuid())
  chatId   String   @unique // رقم المحادثة في تيليجرام
  userId   String?
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenantId String?
  linkedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
}

// رمز ربط مؤقت يُولَّد من اللوحة ويدخله ولي الأمر في البوت
model TelegramLinkCode {
  id        String   @id @default(cuid())
  code      String   @unique // رمز مكوّن من 6 أرقام/حروف
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}
